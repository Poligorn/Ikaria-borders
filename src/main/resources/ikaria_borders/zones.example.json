{
  "_comment": "Ikaria Borders zones.json (v1). Формы: circle{center,radius}, square{center,half; граница снаружи}, rect{from,to; включительно}, polygon{points>=3}, union{shapes}, difference{base,minus}. Приоритет: больше побеждает. parent наследует правила. mapOnly/rules:false — только для карты. Штриховка заливки на карте = приват запрещён (дикие земли: style fill; spawn/build — только обводка). Поля _comment игнорируются.",
  "version": 1,
  "global": {
    "claimCheck": "chunk_center",
    "exempt": { "serverClaims": true },
    "messages": { "claimDenied": "В зоне «{zone}» приватить нельзя" },
    "sweep": { "onStart": true, "intervalMinutes": 60, "perTick": 200, "dryRun": false }
  },
  "zones": [
    {
      "id": "wild", "name": "Дикие земли", "dimension": "minecraft:overworld",
      "default": true, "priority": 0,
      "rules": { "pvp": true, "claims": { "allow": false, "forceload": false, "anchor": false } },
      "map": { "show": true, "color": "#FF3030", "style": "fill", "opacity": 0.3, "label": "Дикие земли — приват запрещён" },
      "meta": { "hud": "wild" }
    },
    {
      "id": "build", "name": "Зона застройки", "dimension": "minecraft:overworld",
      "shape": { "type": "square", "center": [0, 0], "half": 1500 },
      "priority": 20, "parent": "wild",
      "rules": { "claims": { "allow": true, "forceload": true, "anchor": true } },
      "map": { "show": true, "color": "#3399FF", "style": "outline", "opacity": 1, "label": "Зона застройки" },
      "meta": { "hud": "build" }
    },
    {
      "id": "spawn", "name": "Спавн", "dimension": "minecraft:overworld",
      "shape": { "type": "square", "center": [0, 0], "half": 100 },
      "priority": 30, "parent": "build",
      "rules": { "pvp": false },
      "map": { "show": true, "color": "#55FF55", "style": "outline", "opacity": 1 },
      "meta": { "hud": "spawn" }
    },
    {
      "id": "edge", "name": "Край мира", "dimension": "minecraft:overworld",
      "shape": { "type": "square", "center": [0, 0], "half": 10000 },
      "priority": 5, "mapOnly": true,
      "map": { "show": true, "color": "#AA00FF", "style": "outline", "side": "inner" }
    },
    { "id": "nether", "name": "Ад", "dimension": "minecraft:the_nether", "default": true, "priority": 0, "rules": { "pvp": true }, "meta": { "hud": "nether" }, "map": { "show": false } },
    { "id": "end", "name": "Энд", "dimension": "minecraft:the_end", "default": true, "priority": 0, "rules": { "pvp": true }, "meta": { "hud": "end" }, "map": { "show": false } }
  ]
}
